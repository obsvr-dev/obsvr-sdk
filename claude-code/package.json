{
  "name": "@obsvr/claude-code",
  "version": "0.10.0",
  "description": "Govern a coding agent's NATIVE tool calls on the same signed audit chain as the rest of obsvr — a PreToolUse hook that refuses by policy.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    }
  },
  "bin": {
    "obsvr-claude-code-pretooluse": "dist/bin/pretooluse.js"
  },
  "files": [
    "dist/src",
    "dist/bin",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "dependencies": {
    "@obsvr/sdk": "file:../sdk-typescript"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
