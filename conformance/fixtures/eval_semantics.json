    {
      "id": "ev22_explain_pure",
      "sdk_support": { "ts": "required", "py": "required" },
      "ev": "EV-22",
      "mode": "explain",
      "desc": "explain() runs the same decision logic but consumes nothing. With a one-per-window quota rule, three explains leave the budget untouched: the next REAL evaluation is still allowed, and only the one after it is blocked.",
      "rules": [
        {
          "id": "r-quota",
          "name": "One call per window",
          "enabled": true,
          "action": "block",
          "type": "quota",
          "conditions": {
            "quota_limit": 1,
            "quota_window_ms": 60000,
            "quota_scope": "project"
          }
        }
      ],
      "input": {
        "text": "hello"
      },
      "explain_runs": 3,
      "expect": {
        "decision": "allow",
        "rule_id": null
      },
      "expect_first_real_call": {
        "decision": "allow",
        "rule_id": null
      },
      "expect_second_real_call": {
        "decision": "block",
        "rule_id": "r-quota"
      }
    },
    {
      "id": "reserved_rule_id_rejected",
      "sdk_support": { "ts": "required", "py": "required" },
      "ev": "reserved-namespace",
      "desc": "an operator rule claiming the SDK's own verdict namespace (sdk:/backend:) is invalid before it can evaluate: a forged sdk:* rule would be indistinguishable from the SDK's own governance verdicts (sdk:canary_leak, sdk:session_tainted, ...) on the audit record, so the namespace is reserved at the validator, the same discipline as a schema-level reserved-reason pattern",
