    {
      "id": "ns_asymmetric_caller_missing_blocks",
      "sdk_support": { "ts": "required", "py": "required" },
      "ev": "NS-fail-closed",
      "note": "One namespace present, the other missing, is how an attacker nulls a namespace to defeat isolation: fail closed. Context carries both key spellings because TS reads camelCase (callerNamespace) and Python snake_case (caller_namespace); each SDK ignores the other's key.",
      "rules": [
        {
          "id": "r-ns",
          "name": "Namespace isolation",
          "enabled": true,
          "action": "block",
          "type": "namespace_isolation",
          "conditions": {}
        }
      ],
      "input": {
        "text": "read patient chart",
        "context": {
          "targetNamespace": "hospital-b",
          "target_namespace": "hospital-b"
        }
      },
      "expect": {
        "decision": "block",
        "rule_id": "r-ns"
      }
    },
    {
      "id": "ns_asymmetric_target_missing_blocks",
      "sdk_support": { "ts": "required", "py": "required" },
      "ev": "NS-fail-closed",
      "rules": [
        {
          "id": "r-ct",
          "name": "Cross-tenant block",
          "enabled": true,
          "action": "block",
          "type": "cross_tenant_block",
          "conditions": {}
