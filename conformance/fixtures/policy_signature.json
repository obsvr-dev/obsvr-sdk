    "pinned_public_key_b64": "SLF+aEJXSASKMYo33VQ2brKqWLxgIQC42LuHi80XR8g=",
    "pinned_key_id": "ff5d5db9eb589837",
    "other_public_key_b64": "WLNZWG9oNdzR7CVOyqZMoyv5bRWfXRMl6cA5mBMPWo0=",
    "test_only_private_key_seed_b64": "CKMcmDcX2T1B84joNbEqNu7i6/8rRRII2aOwUvbbIbM=",
    "other_test_only_private_key_seed_b64": "TqAQFKlatjvQJDYeBNo0CLdRcMHzxOSUV4E/m+qoxXA=",
    "warning": "THROWAWAY TEST KEYS. Generated solely to produce these vectors, used nowhere else, and safe to publish. The seeds are included so the vectors can be regenerated; never pin these keys in a real deployment."
  },
