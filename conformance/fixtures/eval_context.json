{
  "claimable": false,
  "schema_version": 1,
  "name": "eval_context",
  "description": "Cross-SDK, cross-ENTRY-POINT equivalence of the pre-call rule evaluation context. Every case is one customer policy rule plus the four context values a gate reads - model, provider, environment, prompt - and the verdict that rule must reach. The point is not the verdict: it is that the SAME rule reaches the SAME verdict no matter which door the call came through. A rule whose outcome depends on whether the app used the proxy wrapper or a framework integration is not a policy, it is a coincidence. Harnesses: TypeScript asserts each case TWICE, once through wrap() (proxy wrapper) and once through applyPreCallPolicy (integrations core); Python asserts once through apply_pre_call_policy, which is the single shared pre-call both of its paths use. model_gate and environment_gate are the two rule types that read this context and nothing else, which is what makes them the probe. Cases fix provider to 'openai' so the wrapper harness can drive them with an OpenAI-shaped stub client and all three paths see one provider value.",
  "precall_context_cases": [
    {
      "id": "model_gate_denied_model_blocks",
      "sdk_support": { "ts": "required", "py": "required" },
      "rule": {
        "id": "mg-denied",
        "name": "Deny gpt-4",
        "enabled": true,
        "action": "block",
        "type": "model_gate",
        "conditions": { "denied_models": ["gpt-4"] }
      },
      "environment": "production",
      "model": "gpt-4",
      "provider": "openai",
      "prompt": "summarize this quarter",
      "expect": { "decision": "block", "rule_id": "mg-denied" }
    },
    {
      "id": "model_gate_denied_matches_by_prefix",
      "sdk_support": { "ts": "required", "py": "required" },
      "rule": {
        "id": "mg-prefix",
        "name": "Deny the gpt-4 family",
        "enabled": true,
        "action": "block",
        "type": "model_gate",
        "conditions": { "denied_models": ["gpt-4"] }
      },
      "environment": "production",
      "model": "gpt-4o-mini",
      "provider": "openai",
      "prompt": "summarize this quarter",
      "expect": { "decision": "block", "rule_id": "mg-prefix" }
    },
