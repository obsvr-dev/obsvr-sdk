  "rule_cases": [
    {
      "id": "verb_in_list_blocks",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "rule": {
        "id": "r-facet",
        "name": "facet rule",
        "enabled": true,
        "action": "block",
        "type": "protocol_facet",
        "conditions": {
          "facet": "sql.verb",
          "facet_in": [
            "drop",
            "truncate"
          ]
        }
      },
      "text": "DROP TABLE users",
      "expect": {
        "decision": "block",
        "rule_id": "r-facet",
        "reason_code": "PROTOCOL_FACET_MATCHED"
      }
    },
    {
      "id": "verb_not_in_list_allows",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "rule": {
        "id": "r-facet",
        "name": "facet rule",
        "enabled": true,
        "action": "block",
        "type": "protocol_facet",
        "conditions": {
          "facet": "sql.verb",
          "facet_in": [
            "drop"
          ]
        }
      },
      "text": "SELECT 1 FROM users",
      "expect": {
        "decision": "allow",
        "reason_code": "PERMITTED"
      }
    },
    {
      "id": "verb_allowlist_blocks_everything_else",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "The allowlist shape: only SELECT may run, so an UPDATE fires the rule.",
      "rule": {
        "id": "r-facet",
        "name": "facet rule",
        "enabled": true,
        "action": "block",
        "type": "protocol_facet",
        "conditions": {
          "facet": "sql.verb",
          "facet_not_in": [
            "select"
          ]
        }
      },
      "text": "UPDATE accounts SET balance = 0",
      "expect": {
        "decision": "block",
        "rule_id": "r-facet",
        "reason_code": "PROTOCOL_FACET_MATCHED"
      }
    },
