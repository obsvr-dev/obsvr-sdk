      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "'The object this statement names' is not defined for SELECT - the first name after it is a column - so no target is reported rather than a confident wrong one.",
      "text": "SELECT balance FROM accounts",
      "expect": {
        "parsed": true,
        "verb": "SELECT",
        "tables": [
