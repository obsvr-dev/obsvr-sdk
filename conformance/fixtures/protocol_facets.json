    },
    {
      "id": "function_call_is_not_a_relation",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "A table-valued function after FROM is a function, not a relation.",
      "text": "SELECT * FROM generate_series(1, 10)",
      "expect": {
        "parsed": true,
        "verb": "SELECT",
        "tables": [],
        "functions": [
          "generate_series"
        ],
        "multiple_statements": false
      }
    },
    {
      "id": "stacked_statements_are_flagged",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "A verb-only check sees SELECT here. The facet says there is more than one statement, which is the whole point.",
      "text": "SELECT 1; DROP TABLE users",
      "expect": {
        "parsed": true,
        "verb": "SELECT",
        "tables": [
          "users"
        ],
        "functions": [],
        "multiple_statements": true
      }
    },
    {
      "id": "trailing_semicolon_is_not_stacked",
      "sdk_support": {
