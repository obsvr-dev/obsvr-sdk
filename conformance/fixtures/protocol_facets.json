        "py": "required"
      },
      "desc": "Names compare bare, so a rule listing 'users' catches 'public.users'.",
      "text": "SELECT * FROM analytics.events",
      "expect": {
        "parsed": true,
        "verb": "SELECT",
        "tables": [
          "events"
        ],
        "functions": [],
        "multiple_statements": false
      }
    },
    {
