{
  "claimable": false,
  "schema_version": 1,
  "name": "protocol_facets",
  "description": "Deterministic protocol facets: rule type `protocol_facet` matches PARSED statement structure rather than raw characters, so a rule saying \"the verb is DROP\" survives a comment, a quote-style change or a line break that defeats a regex, and does not fire on prose that merely mentions the word. `facet_cases` pin the decomposition itself - verb, target, tables, functions, and whether more than one statement is present. `rule_cases` pin the rule semantics end to end, including the direction that matters most: text the decomposer cannot speak about (`parsed: false`) MATCHES, so a rule that cannot evaluate refuses rather than permitting. That is the opposite of every other rule type and is deliberate - an attacker who can make a statement unparseable would otherwise have found the bypass. Stdlib-only by construction: a real SQL grammar is a dependency and this package ships none, so the decomposition is lexical, bounded, and explicit about what it does not handle (subquery scopes, CTEs, dialect syntax, precedence). Harnesses: sdk-typescript/tests/unit/protocol-facets-conformance.test.ts, sdk-python/tests/test_protocol_facets_conformance.py.",
  "facet_cases": [
    {
      "id": "simple_select",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "text": "SELECT id FROM users",
      "expect": {
        "parsed": true,
        "verb": "SELECT",
        "tables": [
          "users"
        ],
        "functions": [],
        "multiple_statements": false
      }
    },
    {
      "id": "join_collects_both_relations",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "text": "SELECT * FROM users JOIN orders ON users.id = orders.user_id",
      "expect": {
        "parsed": true,
        "verb": "SELECT",
        "tables": [
          "orders",
          "users"
        ],
        "functions": [],
        "multiple_statements": false
      }
    },
    {
      "id": "comment_between_verb_and_object",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "THE case for facets over patterns: a comment splits DROP from TABLE, defeating /drop\\s+table/i, and the statement still means exactly what it meant.",
      "text": "DROP /* sneaky */ TABLE public.users",
      "expect": {
        "parsed": true,
        "verb": "DROP",
        "target": "users",
        "tables": [
          "users"
        ],
        "functions": [],
        "multiple_statements": false
      }
    },
    {
      "id": "line_comment_is_stripped",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "text": "SELECT 1 -- FROM secrets\nFROM users",
      "expect": {
        "parsed": true,
        "verb": "SELECT",
        "tables": [
          "users"
        ],
        "functions": [],
        "multiple_statements": false
      }
    },
    {
      "id": "comment_marker_inside_a_literal_is_data",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "A '--' inside quotes is content, not a comment; treating it as one would silently truncate the statement being judged.",
      "text": "SELECT '-- not a comment' FROM users",
      "expect": {
        "parsed": true,
        "verb": "SELECT",
        "tables": [
          "users"
        ],
        "functions": [],
        "multiple_statements": false
      }
    },
    {
