            "value": 1699999999999
          }
        ],
        "expect": {
          "valid": false,
          "broken_at": 1,
          "reason": "Timestamp decreased at event 1: 1699999999999 < 1700000000000",
          "events_verified": 1,
          "chain_format": 3
        }
      },
      {
        "id": "reordered_events",
        "sdk_support": {
          "ts": "required",
          "py": "required"
        },
        "desc": "reordering is visible as a sequence gap",
        "mutations": [
          {
            "op": "reverse"
          }
        ],
        "expect": {
          "valid": false,
          "broken_at": 1,
          "reason": "seq_no gap at event 1: expected 3, got 1",
          "events_verified": 1,
          "chain_format": 3
        }
      },
      {
        "id": "mixed_format_chain_rejected",
        "sdk_support": {
          "ts": "required",
          "py": "required"
        },
        "desc": "a chain is one session, one process, one SDK build - no legitimate producer changes format mid-chain, so a later event declaring a different format is a break, not a negotiation",
        "mutations": [
          {
            "op": "set",
            "index": 1,
            "field": "chain_format",
            "value": 1
          }
        ],
        "expect": {
          "valid": false,
          "broken_at": 1,
          "reason": "Chain format mismatch at event 1: expected 3, got 1",
          "events_verified": 1,
          "chain_format": 3
        }
      },
      {
        "id": "unknown_format_rejected",
        "sdk_support": {
          "ts": "required",
          "py": "required"
        },
        "desc": "a chain_format this build does not implement fails closed rather than being guessed at - including one from a NEWER SDK, which must report unsupported rather than verify under an older rule",
        "mutations": [
          {
            "op": "set",
            "index": 0,
            "field": "chain_format",
            "value": 99
          }
        ],
        "expect": {
          "valid": false,
          "broken_at": 0,
          "reason": "Unsupported chain_format at event 0: 99",
          "events_verified": 0
        }
      },
      {
        "id": "downgrade_stripped_marker_rejected",
        "sdk_support": {
          "ts": "required",
          "py": "required"
        },
        "desc": "stripping chain_format from a format-2 chain reroutes verification to the legacy rule, where a format-2 signature can never recompute: the formats share no valid signature, so a downgrade is a break, not a bypass",
        "mutations": [
          {
            "op": "delete",
            "index": 0,
            "field": "chain_format"
          },
          {
            "op": "delete",
            "index": 1,
            "field": "chain_format"
          }
        ],
        "expect": {
          "valid": false,
          "broken_at": 0,
          "reason": "Signature mismatch at event 0",
          "events_verified": 0,
          "chain_format": 1
        }
      },
      {
        "id": "legacy_chain_verifies_as_format_1",
        "sdk_support": {
          "ts": "required",
          "py": "required"
        },
        "desc": "a chain signed before format 2 existed still verifies, and the result says which rule it verified under - never silently as a current chain",
        "events": "legacy_v1",
        "mutations": [],
        "expect": {
          "valid": true,
          "events_verified": 2,
          "chain_format": 1
        }
      },
      {
        "id": "legacy_boundary_resplit_verifies",
        "sdk_support": {
          "ts": "required",
          "py": "required"
        },
        "desc": "DOCUMENTED LIMIT of format 1, identical in both languages: the legacy digest is sha256(prompt + response), so re-splitting 'hello'/'world' as 'hellow'/'orld' preserves the concatenation and the signature still verifies. This is the defect format 2 closes. A format-1 chain therefore proves content-in-order but NOT the prompt/response attribution boundary - which is exactly why the verifier reports chain_format, so a consumer weighing legacy evidence knows what it does and does not bind. Pinned so the limit is a stated decision, not an oversight.",
        "events": "legacy_v1",
        "mutations": [
          {
            "op": "set",
            "index": 0,
            "field": "prompt",
            "value": "hellow"
          },
          {
            "op": "set",
            "index": 0,
            "field": "response",
            "value": "orld"
          }
        ],
        "expect": {
          "valid": true,
          "events_verified": 2,
          "chain_format": 1
        }
      },
      {
        "id": "format_claim_on_legacy_event_rejected",
        "sdk_support": {
          "ts": "required",
          "py": "required"
        },
        "desc": "claiming format 2 on an event signed under format 1 fails: the recomputed format-2 payload never matches a format-1 signature",
        "events": "legacy_v1",
        "mutations": [
          {
            "op": "set",
            "index": 0,
            "field": "chain_format",
            "value": 2
          }
        ],
        "expect": {
          "valid": false,
          "broken_at": 0,
          "reason": "Signature mismatch at event 0",
          "events_verified": 0,
          "chain_format": 2
        }
      },
      {
        "id": "front_truncated_is_not_detectable",
        "sdk_support": {
          "ts": "required",
          "py": "required"
        },
        "desc": "DOCUMENTED LIMIT, identical in both languages: verification proves the events it is given are genuine, in order, and unmodified - not that they are all of them. A suffix starting at seq_no 2 is internally consistent, and nothing inside an export says the session began at 1. Detecting a dropped prefix needs the session's known start (the server-side sequence guard and the sealed ledger). Pinned so the silence is a decision, not an oversight.",
        "mutations": [
          {
            "op": "drop_event",
            "index": 0
          }
        ],
        "expect": {
          "valid": true,
          "events_verified": 1,
          "chain_format": 3
        }
      },
      {
        "id": "verdict_flipped_blocked_to_allowed",
        "sdk_support": {
          "ts": "required",
          "py": "required"
        },
        "desc": "THE case format 3 exists for: rewriting the verdict on a blocked event breaks its signature. Under format 2 this verified clean.",
        "mutations": [
          {
            "op": "set",
            "index": 1,
            "field": "action_taken",
            "value": "allowed"
          }
        ],
        "expect": {
          "valid": false,
          "broken_at": 1,
          "reason": "Signature mismatch at event 1",
          "events_verified": 1,
          "chain_format": 3
        }
      },
      {
        "id": "action_reason_rewritten",
        "sdk_support": {
