        "user_id": 123
      },
      "expect": "123"
    },
    {
      "id": "empty_then_tenant",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "metadata": {
        "user_id": "",
        "session_id": "",
        "tenant_id": "t9"
      },
      "expect": "t9"
