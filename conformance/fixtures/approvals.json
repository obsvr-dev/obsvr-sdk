    {
      "id": "minimal",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "Only the two fields every action has. Absent values are OMITTED, never serialised as null, so 'no amount' and 'amount: null' cannot hash differently.",
      "action": {
        "rule_id": "r-wire",
        "rule_hash": "0123456789abcdef"
      },
      "expect": {
        "document": {
          "schema": "obsvr-action/1",
          "rule_hash": "0123456789abcdef",
          "rule_id": "r-wire"
        },
        "hash": "873156cccd4e3c2151e148acac17d4c98b9b596b5b6b8cbd73641a2578117b30"
      }
    },
