      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "THE case: the grant was minted for one call and a different call trips the same rule. It is refused.",
      "grants": [
        {
          "id": "g1",
          "rule_id": "r-wire",
          "expires_at": "2999-01-01T00:00:00Z",
          "action_hash": "aaaa"
        }
      ],
      "claim": {
        "rule_id": "r-wire",
        "action_hash": "bbbb"
      },
      "expect": false
    },
