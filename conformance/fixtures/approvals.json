  "match_cases": [
    {
      "id": "unbound_grant_satisfies_a_bound_call",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "Compatibility: a grant issued before the SDK started binding actions still satisfies. This is a real weakening and it is the ISSUER's to close - the SDK cannot invent a binding the granting party never made.",
      "grants": [
        {
          "id": "g1",
          "rule_id": "r-wire",
          "expires_at": "2999-01-01T00:00:00Z"
        }
      ],
      "claim": {
        "rule_id": "r-wire",
        "action_hash": "aaaa"
      },
      "expect": true
    },
    {
      "id": "bound_grant_satisfies_the_same_action",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "grants": [
        {
          "id": "g1",
          "rule_id": "r-wire",
          "expires_at": "2999-01-01T00:00:00Z",
          "action_hash": "aaaa"
        }
