      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "A call whose action could not be hashed presents no action_hash, and each pin only NARROWS - so the check does not apply. Stated rather than silent: the binding is only as strong as both sides make it.",
      "grants": [
