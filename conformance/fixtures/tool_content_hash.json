    {
      "id": "behavior_hint_moves_the_pin_and_not_the_content_hash",
      "sdk_support": { "ts": "required", "py": "required" },
      "note": "annotations.destructiveHint flips false -> true. The PINNING hash changes (that is the rug-pull it defends against); the tool_content_hash does NOT, because annotations are outside the platform-defined evidence projection. Proves the two are genuinely distinct rather than differently-encoded versions of one digest.",
      "descriptor": {
        "name": "read_file",
        "description": "Reads a file at a path.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ]
        },
        "title": "Read File",
        "annotations": {
          "destructiveHint": true
        }
      },
      "baseline_id": "projections_differ_for_the_same_descriptor",
      "args": {
        "path": "/etc/hosts"
      },
      "expect": {
        "pinning_descriptor_hash": "f085a79086c8043bf63a36c14721a917591648df938eab29b3c6fea098a99861",
        "content_descriptor_sha256": "41d16e103251b10c0dc2230db664081159ba85053754ba5c5c3409c59f41eefa",
        "content_hash": "5d635fd4e37eb8a2b13aecacd23afafc1045796c889acfb841bd9fdfc9f07fda",
        "baseline_content_hash": "5d635fd4e37eb8a2b13aecacd23afafc1045796c889acfb841bd9fdfc9f07fda",
        "pinning_hash_changed": true,
        "content_hash_changed": false
      }
    }
  ],
