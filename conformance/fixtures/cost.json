{
  "claimable": false,
  "schema_version": 1,
  "name": "cost",
  "description": "Layered call cost. Three layers, each overriding the one before and ALL retained: a caller/tool estimate, an operator-declared cost that overrides it (the caller is the party being governed, so its claim about its own cost is not evidence about itself), and a metered figure from provider-reported usage priced at the operator's own rates. `resolve_cases` pin the resolution, `price_cases` pin the rate arithmetic on its own, `metadata_cases` pin what reaches the event. Two design facts the cases exist to hold: every amount is an INTEGER count of millionths of a currency unit, because money in binary floating point does not agree between two runtimes at the edges and a sealed amount that differs in the last place is not evidence; and rounding is half-up applied ONCE on the final division, spelled out rather than delegated, because Python's round() is banker's rounding and JavaScript's Math.round is not. No provider price list ships in this package - a stale rate baked into a release produces a sealed wrong number, and sealed evidence cannot be reissued. Harnesses: sdk-typescript/tests/unit/cost-conformance.test.ts, sdk-python/tests/test_cost_conformance.py.",
  "resolve_cases": [
    {
      "id": "nothing_configured",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "No policy and no caller claim: the result is empty. An unknown cost is absent, never zero - a cost of zero and an unknown cost are different facts.",
      "inputs": {},
      "expect": {}
    },
    {
      "id": "caller_estimate_only",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "Layer 1 alone.",
      "inputs": {
        "caller_estimate_micros": 500
      },
      "expect": {
        "estimate_micros": 500,
        "estimate_source": "caller"
      }
    },
    {
      "id": "policy_overrides_caller",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
      "desc": "Layer 2 beats layer 1: the caller is the party being governed, so its own claim about its cost is not evidence about itself.",
      "inputs": {
        "policy": {
          "currency": "USD",
          "rates": {
            "gpt-4": {
              "input_micros_per_1k": 30000,
              "output_micros_per_1k": 60000
            },
            "gpt-4o": {
              "input_micros_per_1k": 2500,
              "output_micros_per_1k": 10000
            },
            "claude": {
              "input_micros_per_1k": 3000,
              "output_micros_per_1k": 15000
            }
          },
          "declared": {
            "wire_transfer": 250000,
            "gpt-4": 1000
          }
        },
        "action_name": "wire_transfer",
        "caller_estimate_micros": 500
      },
      "expect": {
        "currency": "USD",
        "estimate_micros": 250000,
        "estimate_source": "policy"
      }
    },
    {
      "id": "policy_declared_by_model_when_no_action",
      "sdk_support": {
        "ts": "required",
        "py": "required"
      },
